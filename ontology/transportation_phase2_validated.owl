  <hasRole rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Emergency</hasRole>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Congestion_1">
  <rdf:type rdf:resource="#Congestion"/>
  <Influences rdf:resource="#Route_1"/>
  <congestionLevel rdf:datatype="http://www.w3.org/2001/XMLSchema#string">High</congestionLevel>
  <avgSpeed rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">15.0</avgSpeed>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Route_1">
  <rdf:type rdf:resource="#Route"/>
  <routeId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">R001</routeId>
  <routeDistance rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">12.0</routeDistance>
</owl:NamedIndividual>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#Road"/>
    <rdf:Description rdf:about="#Junction"/>
    <rdf:Description rdf:about="#Vehicle"/>
    <rdf:Description rdf:about="#Signal"/>
    <rdf:Description rdf:about="#Route"/>
    <rdf:Description rdf:about="#Congestion"/>
    <rdf:Description rdf:about="#Incident"/>
  </owl:members>
</owl:AllDisjointClasses>

<owl:AllDisjointClasses>
  <owl:members rdf:parseType="Collection">
    <rdf:Description rdf:about="#Road"/>
    <rdf:Description rdf:about="#Junction"/>
    <rdf:Description rdf:about="#Vehicle"/>
    <rdf:Description rdf:about="#Signal"/>
    <rdf:Description rdf:about="#Route"/>
    <rdf:Description rdf:about="#Congestion"/>
    <rdf:Description rdf:about="#Incident"/>
  </owl:members>
</owl:AllDisjointClasses>


</rdf:RDF>
