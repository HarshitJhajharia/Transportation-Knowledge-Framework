  <incidentType rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Accident</incidentType>
  <severity rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3</severity>
  <startTime rdf:datatype="http://www.w3.org/2001/XMLSchema#string">2026-10-27T10:30:00</startTime>
</owl:NamedIndividual>

