  <vehicleId rdf:datatype="http://www.w3.org/2001/XMLSchema#string">AMB001</vehicleId>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Signal_B">
  <rdf:type rdf:resource="#Signal"/>
  <controls rdf:resource="#Junction_B"/>
  <LocatedAt rdf:resource="#Junction_B"/>
  <Prioritizes rdf:resource="#Ambulance_1"/>
  <signalState rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Green</signalState>
  <signalPhase rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Emergency Priority</signalPhase>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#Car_1">
  <rdf:type rdf:resource="#Car"/>
</owl:NamedIndividual>

<owl:NamedIndividual rdf:about="#EmergencyVehicle_1">
  <rdf:type rdf:resource="#EmergencyVehicle"/>
</owl:NamedIndividual>

